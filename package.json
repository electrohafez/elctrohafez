{
  "name": "niroo-electric",
  "version": "1.0.0",
  "private": true,
  "description": "Niroo Electric: API-first electrical store with PostgreSQL, admin panel and n8n order automation",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "typecheck": "node scripts/check-syntax.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "smoke": "node scripts/smoke.js",
    "n8n:test": "node scripts/n8n-fixture.js"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "globals": "^16.0.0"
  }
}
