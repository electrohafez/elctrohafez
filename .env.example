# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/niroo
DATABASE_SSL=false

# Admin panel login (min 12 chars) and cookie signing secret (min 32 chars)
ADMIN_PASSWORD=
SESSION_SECRET=

# Behind Railway's proxy set to true so rate limits use the real client IP
TRUST_PROXY=false
# Optional comma-separated list of extra origins allowed to call the public API
CORS_ORIGINS=

# Shipping rules, amounts in Toman
SHIPPING_FEE=180000
FREE_SHIPPING_OVER=5000000
LOW_STOCK_THRESHOLD=5

# n8n: outbound order events (store -> n8n)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
OUTBOX_POLL_MS=3000
OUTBOX_MAX_ATTEMPTS=8

# n8n: inbound events (n8n -> store), HMAC secret
N8N_INBOUND_SECRET=
